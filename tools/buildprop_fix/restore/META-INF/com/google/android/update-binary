#!/sbin/sh
# UJC201 build.prop restore (zip TWRP) : remet les build.prop d'origine.
# Source : <fichier>.bak a cote du fichier, sinon la copie la plus recente de
# /sdcard/UJC201_buildprop_backup/<date>/. Le .bak est conserve.

OUTFD=$2
ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
abort() { ui_print "ERREUR : $1"; cleanup; exit 1; }

BYNAME=/dev/block/platform/bootdevice/by-name
SYSMNT=${UJC_SYSMNT:-/system_root}
SDCARD=${UJC_SDCARD:-/data/media/0}
cleanup() { [ -n "$UJC_TEST" ] || umount $SYSMNT 2>/dev/null; }

ui_print "UJC201 - build.prop restore"
ui_print "---------------------------"
if [ -z "$UJC_TEST" ]; then
	umount $SYSMNT 2>/dev/null; umount /system 2>/dev/null
	mkdir -p $SYSMNT
	blockdev --setrw $BYNAME/system 2>/dev/null
	mount -t ext4 -o rw $BYNAME/system $SYSMNT || abort "montage de system impossible"
fi

LAST=$(ls -d $SDCARD/UJC201_buildprop_backup/*/ 2>/dev/null | sort | tail -n1)
DONE=0
for f in $SYSMNT/system/build.prop $SYSMNT/build.prop; do
	src=""
	if [ -f "$f.bak" ]; then src="$f.bak"
	elif [ -n "$LAST" ] && [ -f "${LAST%/}$f" ]; then src="${LAST%/}$f"
	fi
	[ -n "$src" ] || continue
	cat "$src" > "$f" || abort "ecriture de $f impossible"
	sync
	ui_print "$f <- $src"
	DONE=$((DONE + 1))
done

[ $DONE -gt 0 ] || abort "aucune sauvegarde trouvee (.bak ni $SDCARD/UJC201_buildprop_backup)"
ui_print " "
ui_print "$DONE fichier(s) restaure(s)."
cleanup
exit 0
