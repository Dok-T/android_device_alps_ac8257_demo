#!/sbin/sh
# UJC201 build.prop fix (zip TWRP)
# Le firmware Jancar annonce une fausse version dans /system/build.prop :
#   ro.build.version.release=12 (SDK 28 = Android 9) et le fingerprint d'une autre plateforme
#   (alps/full_evb3561sv_w_65_m0/...:6.0/MRA58K/...).
# Les vraies valeurs sont reprises du fingerprint de /vendor/build.prop (ro.vendor.build.fingerprint) :
#   ro.build.version.release, ro.build.fingerprint, ro.build.description.
# Sauvegarde de chaque fichier modifie : <fichier>.bak a cote (garde l'original s'il existe deja)
# + copie dans /sdcard/UJC201_buildprop_backup/<date>/ (meme arborescence).
# Retour : zip ujc201_buildprop_restore.

OUTFD=$2
ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
abort() { ui_print "ERREUR : $1"; cleanup; exit 1; }

BYNAME=/dev/block/platform/bootdevice/by-name
SYSMNT=${UJC_SYSMNT:-/system_root}
VENMNT=${UJC_VENMNT:-/vendor}
SDCARD=${UJC_SDCARD:-/data/media/0}
MOUNTED_SYS=0; MOUNTED_VEN=0

cleanup() {
	[ -n "$UJC_TEST" ] && return
	[ $MOUNTED_VEN = 1 ] && umount $VENMNT 2>/dev/null
	umount $SYSMNT 2>/dev/null
}

prop() { grep -m1 "^$1=" "$2" 2>/dev/null | cut -d= -f2-; }

ui_print "UJC201 - build.prop fix (Android version / fingerprint)"
ui_print "-------------------------------------------------------"

# --- montages : system en lecture-ecriture, vendor en lecture seule
if [ -z "$UJC_TEST" ]; then
	umount $SYSMNT 2>/dev/null; umount /system 2>/dev/null
	mkdir -p $SYSMNT
	blockdev --setrw $BYNAME/system 2>/dev/null
	mount -t ext4 -o rw $BYNAME/system $SYSMNT || abort "montage de system impossible"
	if ! grep -q " $VENMNT " /proc/mounts; then
		mkdir -p $VENMNT
		mount -t ext4 -o ro $BYNAME/vendor $VENMNT || abort "montage de vendor impossible"
		MOUNTED_VEN=1
	fi
	[ -d $SDCARD ] || abort "memoire interne non montee (/data dechiffre ?) : pas de copie de sauvegarde possible"
fi

# --- valeurs de reference : fingerprint vendor
VFP=$(prop ro.vendor.build.fingerprint $VENMNT/build.prop)
[ -n "$VFP" ] || abort "ro.vendor.build.fingerprint introuvable dans $VENMNT/build.prop"
# brand/name/device:release/id/incremental:type/tags
NAME=$(echo "$VFP" | cut -d/ -f2)
REL=$(echo "$VFP" | cut -d: -f2 | cut -d/ -f1)
BID=$(echo "$VFP" | cut -d/ -f4)
INC=$(echo "$VFP" | cut -d/ -f5 | cut -d: -f1)
TYPE=$(echo "$VFP" | cut -d: -f3 | cut -d/ -f1)
TAGS=$(echo "$VFP" | cut -d/ -f6)
DESC="$NAME-$TYPE $REL $BID $INC $TAGS"
case "$REL" in ''|*[!0-9.]*) abort "fingerprint vendor inattendu : $VFP";; esac
ui_print "Reference (vendor) : $VFP"

# --- fichiers a corriger : build.prop du system (fichiers reguliers uniquement)
FILES=""
for f in $SYSMNT/system/build.prop $SYSMNT/build.prop; do
	[ -f "$f" ] && [ ! -L "$f" ] && grep -q '^ro.build.fingerprint=' "$f" && FILES="$FILES $f"
done
[ -n "$FILES" ] || abort "aucun build.prop trouve dans $SYSMNT"

# espace libre (sauvegarde .bak a cote)
FREE=$(df -k $SYSMNT 2>/dev/null | tail -n1 | awk '{print $4}')
[ -n "$FREE" ] && [ "$FREE" -lt 64 ] && abort "partition system pleine (${FREE} Ko libres)"

STAMP=$(date +%Y%m%d-%H%M%S)
BKDIR=$SDCARD/UJC201_buildprop_backup/$STAMP
CHANGED=0

for f in $FILES; do
	ui_print " "
	ui_print "$f"
	OLDREL=$(prop ro.build.version.release "$f"); OLDFP=$(prop ro.build.fingerprint "$f")
	OLDDESC=$(prop ro.build.description "$f")
	if [ "$OLDREL" = "$REL" ] && [ "$OLDFP" = "$VFP" ] && [ "$OLDDESC" = "$DESC" ]; then
		ui_print "  deja corrige, rien a faire"; continue
	fi
	ui_print "  release     : $OLDREL -> $REL"
	ui_print "  fingerprint : $OLDFP"
	ui_print "             -> $VFP"
	ui_print "  description : $OLDDESC -> $DESC"

	# sauvegardes (avant toute modification)
	if [ -f "$f.bak" ]; then
		ui_print "  $f.bak existe deja : conserve (original)"
	else
		cp -p "$f" "$f.bak" || abort "copie $f.bak impossible"
		ui_print "  sauvegarde : $f.bak"
	fi
	mkdir -p "$BKDIR$(dirname "$f")" || abort "dossier $BKDIR impossible"
	cp -p "$f" "$BKDIR$f" || abort "copie vers la memoire interne impossible"
	ui_print "  copie      : $BKDIR$f"

	# remplacement des 3 lignes ; reecriture sur place (garde inode, droits et contexte SELinux)
	TMP=/tmp/ujc201_buildprop.$$
	sed -e "s|^ro.build.version.release=.*|ro.build.version.release=$REL|" \
	    -e "s|^ro.build.fingerprint=.*|ro.build.fingerprint=$VFP|" \
	    -e "s|^ro.build.description=.*|ro.build.description=$DESC|" "$f" > $TMP || abort "sed"
	[ -s $TMP ] || abort "resultat vide, fichier non modifie"
	cat $TMP > "$f" || abort "ecriture de $f impossible (restaurer $f.bak)"
	rm -f $TMP
	sync

	# verification
	[ "$(prop ro.build.version.release "$f")" = "$REL" ] && [ "$(prop ro.build.fingerprint "$f")" = "$VFP" ] \
		|| abort "verification echouee : restaurer $f.bak"
	ui_print "  OK"
	CHANGED=$((CHANGED + 1))
done

ui_print " "
if [ $CHANGED -gt 0 ]; then
	ui_print "$CHANGED fichier(s) corrige(s). Sauvegarde : $BKDIR"
else
	ui_print "Aucune modification."
fi
ui_print "Retour arriere : flasher ujc201_buildprop_restore.zip"
cleanup
exit 0
