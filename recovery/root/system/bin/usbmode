#!/system/bin/sh
# usbmode host|device - bascule le port USB OTG (musb) de l'UJC201
# Le pilote MTK ne gere que data_role (mode ufp/dfp non supporte).
D=/sys/devices/platform/mt_usb/musb-hdrc
R=$D/dual_role_usb/dual-role-usb20
G=/config/usb_gadget/g1
case "$1" in
  host)
    echo "" > $G/UDC 2>/dev/null          # coupe le gadget adb/MTP
    echo host > $R/data_role
    sleep 2
    ;;
  device)
    echo device > $R/data_role
    sleep 2
    echo musb-hdrc > $G/UDC 2>/dev/null   # reactive adb/MTP
    ;;
esac
echo "USB: mode=$(cat $D/mode) role=$(cat $R/data_role)"
