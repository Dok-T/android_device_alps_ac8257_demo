#!/system/bin/sh
# powerinfo - UJC201 : tension d'entree (candidats ADC) + temperature CPU
# Calibration faite a 12.02 V (alim fixe) -> A VALIDER en voiture (12.5 V moteur coupe / ~14 V moteur tournant)
SOC=$(awk -F'[][,]' '$2+0==4 {gsub(/ /,"",$4); print $4}' /sys/devices/virtual/mtk-adc-cali/mtk-adc-cali/AUXADC_read_channel)
VCDT=$(cat /sys/bus/iio/devices/iio:device0/in_voltage2_VCDT_input 2>/dev/null)
CPU=$(cat /sys/class/thermal/thermal_zone1/temp 2>/dev/null)
awk -v s="$SOC" -v v="$VCDT" -v c="$CPU" 'BEGIN{
  printf "Vin ~ %.2f V  (SoC ADC ch4 = %d mV, x13.33)\n", s*12.02/902, s;
  printf "Vin ~ %.2f V  (PMIC VCDT  = %d mV, x18.52)\n", v*12.02/649, v;
  printf "CPU   %.1f C\n", c/1000;
  print  "(calibrated at 12.02 V - not yet validated in car)"}'
# MCU (lu par touchfix sur /dev/ttyS1)
echo "MCU firmware : $(cat /tmp/mcu_version 2>/dev/null || echo 'no answer')"
echo "Vehicle      : $(cat /tmp/twcar_s 2>/dev/null || echo '--')"
